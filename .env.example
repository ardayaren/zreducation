# --- E-posta gönderimi ---
# Seviye tespit sınavı sonuçları + kişisel bilgiler HER GİRİŞTE zreducationn@gmail.com'a gönderilir.
# Gönderen: yzararszsoy@gmail.com (varsayılan)
#
# ÖNERİLEN YOL (Gmail SMTP — alan adı doğrulaması gerekmez):
SMTP_USER=yzararszsoy@gmail.com
SMTP_PASS=buraya-gmail-uygulama-sifresi
ADMIN_EMAIL=zreducationn@gmail.com

# Alternatif (Resend — zreducation.org alan adını Resend'de doğrulamanız gerekir):
# RESEND_API_KEY=
# RESEND_FROM=Zreducation <info@zreducation.org>

# SMTP fallback ayarları (gerekirse)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# Admin paneli (/admin) giriş şifresi — güçlü bir değer yazın
ADMIN_PASSWORD=degistir-bunu-guclu-bir-sifre