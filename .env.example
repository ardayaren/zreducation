# --- E-posta gönderimi ---
# ÖNCELİK: Resend kullanılır (RESEND_API_KEY tanımlıysa).
# RESEND_API_KEY: Resend (resend.com) hesabından alınır. (önerilir)
# RESEND_FROM: Doğrulanmış alan adından gönderim. Örn: Zreducation <info@zreducation.org>
RESEND_API_KEY=
RESEND_FROM=Zreducation <info@zreducation.org>

# Fallback: Resend yoksa SMTP (Gmail) kullanılır.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# Bildirimlerin gittiği adres (yönetici e-postası)
ADMIN_EMAIL=zreducationn@gmail.com

# Admin paneli (/admin) giriş şifresi — güçlü bir değer yazın
ADMIN_PASSWORD=degistir-bunu-guclu-bir-sifre